# ── Platform Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string for the SQLense platform database
# (stores users, org configs, query history, audit logs, KPI tiles)
PLATFORM_DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/sqlense

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Fernet Encryption (for org DB credentials) ─────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# ── Ollama (AI Engine) ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── CORS (Frontend URLs) ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── SuperAdmin Credentials ─────────────────────────────────────────────────────
# These are the developer/platform-operator credentials.
# NOT stored in the database — only checked against these env vars.
# Change these before deployment!
SUPERADMIN_EMAIL=superadmin@sqlense.dev
SUPERADMIN_PASSWORD=SuperAdmin@2024!
